<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Preview Image — 2/3 of screen -->
    <ImageView
        android:id="@+id/previewImageView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:scaleType="fitCenter"
        android:background="#000000" />

    <!-- Controls Panel — 1/3 of screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#222222"
        android:paddingStart="1dp"
        android:paddingEnd="1dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:gravity="center_vertical">

        <!-- Frame counter -->
        <TextView
            android:id="@+id/frameCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Frame 1 / 10"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:gravity="center"
            android:paddingBottom="1dp" />

        <!-- Seekbar -->
        <SeekBar
            android:id="@+id/frameSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp" />

        <!-- Row 1: Playback controls + FPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="1dp">

            <Button
                android:id="@+id/playButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="▶ Play"
                android:textSize="13sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/closeButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="✕ Close"
                android:textSize="13sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginStart="4dp" />

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#555555"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FPS:"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/fps8Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="8"
                android:textSize="13sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/fps12Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="12"
                android:textSize="13sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginStart="2dp" />

            <Button
                android:id="@+id/fps24Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="24"
                android:textSize="13sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginStart="2dp" />


            <Button
                android:id="@+id/moveLeftButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="◀"
                android:textSize="14sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:contentDescription="Move frame left" />

            <Button
                android:id="@+id/moveRightButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="▶"
                android:textSize="14sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginStart="2dp"
                android:contentDescription="Move frame right" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#555555"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />


            <Button
                android:id="@+id/deleteButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🗑 Delete"
                android:textSize="12sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginStart="4dp" />

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#555555"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/exportButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⬆ MP4"
                android:textSize="12sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
